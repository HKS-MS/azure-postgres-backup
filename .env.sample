PGHOST=pgsample89126.postgres.database.azure.com
PGPORT=5432
PGDATABASE=salesdb
PGUSER=id-salesdb-dev-132d
PGSSLMODE=verify-full
PGSSLROOTCERT=system

# Optional: set PGPASSWORD for local testing with standard password auth.
# In Azure Container Apps, leave PGPASSWORD unset: DefaultAzureCredential automatically
# acquires an Entra ID OAuth token for PostgreSQL (https://ossrdbms-aad.database.windows.net/.default).
# PGPASSWORD=

BLOB_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
BLOB_CONTAINER=postgres-backups
# Optional: client ID for a user-assigned managed identity when running in Azure.
# AZURE_CLIENT_ID=
